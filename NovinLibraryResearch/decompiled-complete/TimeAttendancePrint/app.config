<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="TimeAttendancePrint.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <applicationSettings>
        <TimeAttendancePrint.Properties.Settings>
            <setting name="SQLQuery_Company" serializeAs="String">
                <value>select	(select Val from SettingAttendance where name ='TitleSaleMali') as N'عنوان شرکت',
		(select Val from SettingAttendance where name ='CodeEkh') as N'کد اقتصادی',
		(select Val from SettingAttendance where name ='TelSH') as N'تلفن',
		(select Val from SettingAttendance where name ='AddSh') as N'آدرس',
		(select Val from SettingAttendance where name ='FaxSH') as N'فکس',
		(select Val from SettingAttendance where name ='DescSH') as N'شرح شرکت',
        (select Val from SettingAttendance where name ='SabtNO') as N'شماره ثبت شرکت'</value>
            </setting>
        </TimeAttendancePrint.Properties.Settings>
    </applicationSettings>

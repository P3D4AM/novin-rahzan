# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# ================= HozorPlus =================
# runtime database (SQLite) — never commit user data
/db/*.db
/db/*.db-journal
!db/.gitkeep

# original software archive / local uploads & downloads (not part of the product)
/upload/
/download/

# local reverse-engineering / tooling artifacts (not part of the product)
/analysis/
/tool-results/

# sandbox scaffolding & examples
/.zscripts/
/examples/
/tests/
/agent-ctx/

# Skills directory
/skills/
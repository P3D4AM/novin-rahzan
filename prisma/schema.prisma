generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===================== Users & Sessions =====================
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         String    @default("EMPLOYEE") // SUPER_ADMIN | ADMIN | APPROVER | EMPLOYEE
  fullName     String
  phone        String?
  email        String?
  active       Boolean   @default(true)
  personnelId  String?   @unique
  personnel    Personnel? @relation(fields: [personnelId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===================== Organization =====================
model Department {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  personnel   Personnel[]
}

model JobTitle {
  id        String     @id @default(cuid())
  name      String     @unique
  personnel Personnel[]
}

model EmploymentType {
  id        String     @id @default(cuid())
  name      String     @unique
  personnel Personnel[]
}

model Personnel {
  id               String         @id @default(cuid())
  personnelCode    String         @unique
  firstName        String
  lastName         String
  nationalId       String?
  fatherName       String?
  gender           String? // MALE | FEMALE
  birthDate        String? // Jalali string "1370/05/12"
  phone            String?
  email            String?
  address          String?
  photoUrl         String?
  departmentId     String?
  jobTitleId       String?
  employmentTypeId String?
  hireDate         String? // Jalali string
  endDate          String? // Jalali string
  status           String         @default("ACTIVE") // ACTIVE | INACTIVE | TERMINATED
  pin              String         @unique // 4-digit kiosk PIN
  qrToken          String         @unique @default(uuid())
  deviceUserId     Int? // user id on ZK device
  annualLeaveDays  Float          @default(26)
  defaultShiftId   String?
  notes            String?
  department       Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobTitle         JobTitle?      @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  employmentType   EmploymentType? @relation(fields: [employmentTypeId], references: [id], onDelete: SetNull)
  defaultShift     Shift?         @relation("defaultShift", fields: [defaultShiftId], references: [id], onDelete: SetNull)
  user             User?
  punches          PunchRecord[]
  rawPunches       RawPunch[]
  dailyRecords     DailyAttendance[]
  leaveRequests    LeaveRequest[]
  overtimeRequests OvertimeRequest[]
  assignments      ShiftAssignment[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ===================== Shifts =====================
model Shift {
  id           String          @id @default(cuid())
  name         String          @unique
  color        String          @default("#10b981")
  type         String          @default("FIXED") // FIXED | SPLIT
  lateGraceMin Int             @default(10)
  earlyGraceMin Int            @default(10)
  overtimeEligible Boolean     @default(true)
  isActive     Boolean         @default(true)
  segments     ShiftSegment[]
  personnel    Personnel[]     @relation("defaultShift")
  assignments  ShiftAssignment[]
  dailyRecords DailyAttendance[]
}

model ShiftSegment {
  id       String @id @default(cuid())
  shiftId  String
  order    Int    @default(1)
  startMin Int // minutes from 00:00
  endMin   Int // minutes from 00:00; if endMin <= startMin -> crosses midnight
  breakMin Int    @default(0)
  shift    Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
}

model ShiftRotation {
  id       String  @id @default(cuid())
  name     String  @unique
  pattern  String // JSON: [{ "shiftId": "...", "days": 2 }, { "off": true, "days": 1 }]
  isActive Boolean @default(true)
}

model ShiftAssignment {
  id       String   @id @default(cuid())
  personId String
  date     DateTime // day (UTC midnight)
  shiftId  String? // null => off day (تعطیلی شخصی)
  note     String?
  person   Personnel @relation(fields: [personId], references: [id], onDelete: Cascade)
  shift    Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([personId, date])
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime // day
  title     String
  type      String   @default("OFFICIAL") // OFFICIAL | COMPANY
  createdAt DateTime @default(now())

  @@unique([date])
}

// ===================== Attendance =====================
model PunchRecord {
  id            String   @id @default(cuid())
  personId      String
  timestamp     DateTime
  direction     String   @default("AUTO") // IN | OUT | AUTO
  source        String   @default("WEB") // WEB | KIOSK | QR | DEVICE | MANUAL | IMPORT
  deviceId      String?
  deviceUserId  Int?
  rawPayload    String?
  edited        Boolean  @default(false)
  editReason    String?
  latitude      String?
  longitude     String?
  createdAt     DateTime @default(now())
  person        Personnel @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, timestamp, source])
}

model DailyAttendance {
  id                String   @id @default(cuid())
  personId          String
  date              DateTime
  status            String   @default("PENDING") // PRESENT | ABSENT | LEAVE | MISSION | HOLIDAY | OFF | INCOMPLETE | IGNORED
  shiftId           String?
  firstIn           DateTime?
  lastOut           DateTime?
  workedMinutes     Int      @default(0)
  lateMinutes       Int      @default(0)
  earlyLeaveMinutes Int      @default(0)
  overtimeMinutes   Int      @default(0)
  leaveTypeId       String?
  leaveMinutes      Int      @default(0)
  // Phase 2 S3 (overtime_policy = min_excess): payable = min(actual, approved).
  // overtimeMinutes KEEPS its existing meaning (actual overtime); this new
  // additive column is the payable value only. Default 0 = additive, backward
  // compatible (old rows read as "no payable OT approved").
  payableOvertimeMinutes Int  @default(0)
  // Phase 2 S3 (mission_policy = approved_credit): approved mission time
  // credited as valid work time AFTER subtracting actual attendance overlap.
  // workedMinutes = attendance pairs + this value (the policy's final worked).
  missionMinutes   Int      @default(0)
  note              String?
  shift             Shift?     @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  leaveType         LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)
  person            Personnel @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, date])
}

// ===================== Leave =====================
model LeaveType {
  id               String  @id @default(cuid())
  name             String  @unique
  paid             Boolean @default(true)
  requiresApproval Boolean @default(true)
  color            String  @default("#f59e0b")
  countsTowardsBalance Boolean @default(true)
  // Phase 2 S3 (mission_policy = approved_credit): explicit machine flag — a
  // mission is a LeaveType with isMission=true. NEVER detected by Persian
  // name matching. Additive, default false: existing rows keep their meaning.
  isMission        Boolean @default(false)
  requests         LeaveRequest[]
  dailyRecords     DailyAttendance[]
}

model LeaveRequest {
  id               String    @id @default(cuid())
  personId         String
  leaveTypeId      String
  kind             String    @default("DAILY") // DAILY | HOURLY
  startDateTime    DateTime
  endDateTime      DateTime
  durationMinutes  Int       @default(0)
  reason           String?
  status           String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  approverId       String?
  decisionNote     String?
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())
  leaveType        LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  person           Personnel @relation(fields: [personId], references: [id], onDelete: Cascade)
}

// ===================== Overtime =====================
model OvertimeRequest {
  id         String    @id @default(cuid())
  personId   String
  date       DateTime
  minutes    Int
  reason     String?
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approverId String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
  person     Personnel @relation(fields: [personId], references: [id], onDelete: Cascade)
}

// ===================== Devices =====================
model Device {
  id            String       @id @default(cuid())
  name          String
  type          String       @default("ZKTECO") // ZKTECO | IMPORT | NOVIN_NP
  // v1.4.0 (addendum P1) — which device driver/SDK family serves this device.
  // EXPLICITLY selected by the admin (never guessed from the port number):
  //   SBXPC    — NP-series binary protocol on :5005 (legacy path, kept working)
  //   FKATTEND — official FKAttend SDK (x86 bridge) — default port 4238 (NP756+)
  protocolFamily String     @default("SBXPC")
  ipAddress     String?
  port          Int          @default(4370)
  protocol      String       @default("TCP") // TCP | UDP
  location      String?
  serialNumber  String?
  password      Int? // «رمز شبکه» — NP devices with the encrypted protocol (EXT_SECURE); NEVER returned by APIs/logs
  // v1.3.1 (Phase 1 review fix 6) — OPTIONAL at-rest protection of the network password
  // via Windows DPAPI (see docs/SECURITY-device-password-at-rest.md). Format:
  // "dpapi:machine:<base64 blob>". While null, the password lives as the plaintext
  // integer above (the documented, explicitly accepted gap). Opt-in only:
  // scripts/protect-device-secrets.ts — never enabled silently, never guessed.
  passwordEnc   String? // protected at-rest form of the same secret (kept exclusive with password)
  // v1.4.0 (addendum P1) — per-device connection / SDK parameters (all validated in backend)
  connTimeoutMs Int          @default(5000) // FK_ConnectNet timeout
  machineNumber Int          @default(1) // SDK machine number
  sdkLicense    Int          @default(1261) // FK623 SDK license constant (from the recorded successful test)
  // v1.5.0: bridgeUrl / bridgeToken REMOVED — the FK623 bridge is fully internal
  // (src/lib/bridge-supervisor.ts): started/restarted/stopped by the app with a
  // per-launch memory-only token. Nothing bridge-related is user-configurable
  // anymore (migration migrate-v1.5.0-bridge-internal.mjs drops the columns).
  enabled       Boolean      @default(true)
  status        String       @default("UNKNOWN") // ONLINE | OFFLINE | UNKNOWN
  lastSyncAt    DateTime?
  lastSyncCount Int          @default(0)
  lastLogAt     DateTime? // bookmark: newest device log already imported (incremental pull sync)
  rawCursorAt   DateTime? // v1.3.0 Phase 1 — RawPunch pipeline bookmark; advances ONLY after the batch is safely stored
  lastSyncError String? // v1.4.0 (addendum P2) — sanitized last sync error, cleared on success
  // v1.4.0 (addendum P2) — automatic pull (0 = manual only; backend-validated 0..1440 minutes)
  syncIntervalMin Int        @default(0)
  // v1.4.0 (addendum P3) — near real-time polling (honest label; NOT real push). Off by default.
  rtEnabled     Boolean      @default(false)
  rtPollSec     Int          @default(30) // backend-validated 15..600 seconds
  rtLastPollAt  DateTime?
  createdAt     DateTime     @default(now())
  logs          DeviceLog[]
  rawPunches    RawPunch[]
  syncRuns      DeviceSyncRun[]
  rejectedRecords RejectedRecord[]
}

model DeviceLog {
  id        String   @id @default(cuid())
  deviceId  String?
  level     String   @default("INFO") // INFO | WARN | ERROR | SUCCESS
  message   String
  createdAt DateTime @default(now())
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

// ===================== Raw Punch Integrity Layer (v1.3.0 — Phase 1) =====================
// RawPunch is the immutable landing zone for attendance records coming from devices
// (FKATTEND x86 bridge, SBXPC pull, …) or reference CSV imports.
// Design rules (HozorPlus Blueprint — Data Integrity):
//   * No mandatory personnel mapping: unmatched records are stored with
//     matchStatus = UNMATCHED and are NEVER dropped or deleted.
//   * Punch direction is never guessed: inOutModeRaw/verifyModeRaw are kept as-is
//     and direction stays "UNKNOWN" until the vendor meaning is confirmed.
//   * Dedupe identity = device + enroll number + raw fields (+ rawFingerprint hash);
//     dupIndex distinguishes simultaneous identical punches (same-second multi-punch).
//   * The device wall-clock value is preserved (punchTimeRaw) alongside the UTC instant.
model RawPunch {
  id             String    @id @default(cuid())
  // ---- identity of the physical record (NOT NULL with defaults → safe inside the UNIQUE key)
  deviceSerial   String // physical identity of the device that produced the punch
  sourceProtocol String    @default("UNKNOWN") // FKATTEND | SBXPC | RTLOG | EBIO | CSV_REFERENCE | MOCK
  enrollNumber   String // raw enroll/user number exactly as the device reports it (kept as text)
  punchTime      DateTime // UTC instant of the punch (converted from the device wall clock upstream)
  punchTimeRaw   String    @default("") // device wall-clock string as received — audit trail
  inOutModeRaw  Int       @default(0) // raw in/out value — meaning NOT verified → direction stays UNKNOWN
  verifyModeRaw  Int       @default(0) // raw verify value
  workCode       String    @default("")
  sourceRecordId String    @default("") // protocol-level record id when the source provides one
  rawFingerprint String // sha-256 of the canonical raw tuple — the dedupe key
  dupIndex       Int       @default(0) // ordinal among otherwise-identical records (simultaneous punches)
  // ---- optional relations (a RawPunch survives device / personnel deletion)
  deviceId       String?
  device         Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  personnelId    String?
  personnel      Personnel? @relation(fields: [personnelId], references: [id], onDelete: SetNull)
  // ---- interpretation (never guessed)
  matchStatus    String    @default("UNMATCHED") // UNMATCHED | MATCHED
  direction      String    @default("UNKNOWN") // UNKNOWN until the vendor meaning of in/out is verified
  // v1.3.1 (Phase 1 review fix 1) — why a row is still UNMATCHED: null = plain
  // "no personnel candidate found"; "AMBIGUOUS…" = the enroll number maps to more
  // than one person (or collides across deviceUserId/personnelCode) — the row stays
  // unassigned and visible for an administrator to resolve manually.
  matchNote      String? // null | AMBIGUOUS_<reason> — set only while personnelId is null
  // ---- audit
  rawPayload     String? // minimal raw payload (hex / JSON) for auditing
  syncRunId      String?
  importedAt     DateTime  @default(now())

  @@unique([deviceSerial, sourceProtocol, enrollNumber, rawFingerprint, dupIndex])
  @@index([punchTime])
  @@index([deviceSerial, punchTime])
  @@index([personnelId])
  @@index([matchStatus])
}

// Sync History — one row per device import run (hardware, mock or dry-run).
// The bookmark (bookmarkAt / Device.rawCursorAt) advances ONLY after the raw batch
// is safely committed; error/note messages are sanitized and never contain secrets.
model DeviceSyncRun {
  id              String    @id @default(cuid())
  deviceId        String?
  device          Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  deviceSerial    String    @default("")
  sourceProtocol  String    @default("UNKNOWN") // FKATTEND | SBXPC | …
  mode            String    @default("HARDWARE") // HARDWARE | MOCK | DRY_RUN
  status          String    @default("RUNNING") // RUNNING | SUCCESS | PARTIAL | FAILED
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  recordsSeen     Int       @default(0) // total records reported by the source
  recordsInWindow Int       @default(0) // records inside the requested window
  recordsNew      Int       @default(0) // newly stored RawPunch rows
  recordsDuplicate Int       @default(0) // already stored on a previous run
  recordsMatched  Int       @default(0) // new rows with a personnel mapping
  recordsUnmatched Int       @default(0) // new rows without a personnel mapping (kept, never dropped)
  // v1.3.1 (Phase 1 review fix 4) — full accounting for every source record:
  // malformed records are quarantined in RejectedRecord and counted here, and
  // records excluded by the requested date window are counted separately, so
  // seen = inWindow + rejected + outOfWindow — nothing disappears silently.
  recordsRejected Int       @default(0) // malformed records newly quarantined this run
  recordsOutOfWindow Int    @default(0) // valid records intentionally excluded by the date window
  bookmarkAt      DateTime? // cursor position reached after safe storage
  retries         Int       @default(0) // automatic retries used (withRetry)
  error           String? // sanitized error message — device secrets are never written here
  note            String?

  @@index([deviceSerial, startedAt])
  @@index([deviceId])
}

// Rejected-record quarantine (v1.3.1 — Phase 1 review fix 4). A record the
// source reported but that could NOT be stored as a RawPunch (e.g. an invalid /
// non-finite timestamp) lands here instead of vanishing: the original raw
// payload, enroll number and raw wall-clock string are preserved whenever
// available, plus a machine-readable reject reason. Never auto-purged.
// fingerprint = sha-256 of the canonical rejected tuple → re-reads of the same
// bad record are recognized as duplicates (no row flood from 30s rt-polls).
model RejectedRecord {
  id             String    @id @default(cuid())
  deviceId       String?
  device         Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  deviceSerial   String    @default("")
  sourceProtocol String    @default("UNKNOWN")
  syncRunId      String? // the run that quarantined it first
  enrollNumber   String? // exact string as reported (null when the source provided none)
  punchTimeRaw   String? // device wall-clock string as received, if any
  rawPayload     String? // original raw payload (hex / JSON) whenever available
  rejectReason   String // machine-readable reason, e.g. INVALID_TIMESTAMP
  sourceMeta     String? // JSON of the surviving source fields (inOutModeRaw, verifyModeRaw, …)
  fingerprint    String    @unique // dedupe key — see model comment
  receivedAt     DateTime  @default(now())

  @@index([deviceSerial, receivedAt])
  @@index([rejectReason])
}

// Per-device sync lock (v1.3.1 — Phase 1 review fix 7) — the authoritative
// mutual-exclusion primitive lives IN THE DATABASE so that two server processes
// can never interleave sync operations for the same device (a process-local map
// would only protect one process and would falsely claim protection). The lease
// (expiresAt) guarantees crash recovery: a dead process's lock is taken over
// once the lease expires. Database uniqueness (the RawPunch unique key) remains
// the FINAL duplicate safeguard — the lock is a serialization aid, not a
// correctness claim.
model DeviceSyncLock {
  deviceId   String   @id // locked device — deliberately NO FK: a lock must not depend on the device row
  lockToken  String // random token — only the owner releases
  acquiredAt DateTime @default(now())
  expiresAt  DateTime // lease deadline — takeover is allowed after it passes

  @@index([expiresAt])
}

// ===================== Notifications =====================
model NotificationRule {
  id             String  @id @default(cuid())
  type           String // ABSENT | LATE | CHECKIN | LEAVE_REQUEST | OT_REQUEST
  enabled        Boolean @default(true)
  thresholdMin   Int     @default(0)
  scope          String  @default("ALL") // ALL or comma separated person ids
  notifyRole     String  @default("ADMIN") // ADMIN | APPROVER | SUPER_ADMIN
  createdAt      DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  role      String? // broadcast target role
  title     String
  body      String
  type      String   @default("INFO")
  refId     String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ===================== Settings & Audit =====================
model Setting {
  id    String @id
  value String
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}
